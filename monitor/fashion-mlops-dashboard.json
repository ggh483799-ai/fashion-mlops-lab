{
  "dashboard": {
    "uid": "fashion-mlops-serve",
    "title": "Fashion-MLOps 模型服务监控",
    "tags": ["fashion-mlops", "model-serving"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "15s",
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "预测 QPS",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {"expr": "rate(model_predict_requests_total[5m])", "legendFormat": "QPS", "refId": "A"}
        ],
        "fieldConfig": {
          "defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineWidth": 2}},
          "overrides": []
        }
      },
      {
        "id": 2,
        "type": "timeseries",
        "title": "P99 推理延迟（秒）",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum by (le) (rate(model_predict_latency_seconds_bucket[5m])))",
            "legendFormat": "P99",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 2}},
          "overrides": []
        }
      },
      {
        "id": 3,
        "type": "timeseries",
        "title": "预测错误率",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {
            "expr": "rate(model_predict_errors_total[5m]) / clamp_min(rate(model_predict_requests_total[5m]), 1)",
            "legendFormat": "error rate",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "percentunit", "custom": {"drawStyle": "line", "lineWidth": 2}},
          "overrides": []
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "累计预测次数",
        "gridPos": {"h": 4, "w": 12, "x": 12, "y": 8},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {"expr": "model_predict_requests_total", "legendFormat": "total", "refId": "A"}
        ],
        "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
      }
    ],
    "time": {"from": "now-1h", "to": "now"}
  },
  "overwrite": true
}
